+# Qwen3-4B, single-GPU adaptation of LaTER's public sft_config_14b.yaml.
+# Deliberate deviations required by one 48 GB GPU:
+#   - Qwen3-4B instead of Qwen3-14B
+#   - 4096 instead of 24096 max tokens
+#   - stage 1 only, so transformer blocks remain frozen
+# All dataset, loss, curriculum, and one-epoch settings follow the public config.
+model_path: Qwen/Qwen3-4B
+train_data: data/latent-switch-69k/sft_train.parquet
+val_data: null
+teacher_cache_dir: data/latent-switch-69k/precomputed_teacher
+output_dir: checkpoints/later-4b-stage1
+debug: false
+
+seed: 42
+val_ratio: 0.01
+max_length: 4096
+micro_batch_size: 1
+eval_batch_size: 1
+gradient_accumulation_steps: 4
+num_workers: 2
+num_epochs: 1
+max_train_steps: 0
+max_train_samples: 0
+max_val_samples: 0
+learning_rate: 1.0e-7
+min_lr: 1.0e-8
+weight_decay: 0.01
+adam_beta1: 0.9
+adam_beta2: 0.95
+adam_eps: 1.0e-8
+warmup_ratio: 0.03
+max_grad_norm: 1.0
+optimizer_foreach: false
+freeze_base_token_rows: false
+freeze_base_token_rows_apply_to_lm_head: true
+freeze_base_token_rows_scope: always
+
+mixed_precision: bf16
+mixed_precision_policy: bf16
+torch_dtype: bfloat16
+# SDPA is the portable equivalent when FlashAttention 2 is not installed.
+attn_implementation: sdpa
+transformer_layer_cls: Qwen3DecoderLayer
+gradient_checkpointing: true
+global_stateless_forward: true
+legacy_staged_forward_fallback: false
+latent_projector_dropout: 0.2
+pytorch_cuda_alloc_conf: expandable_segments:True,max_split_size_mb:128
+
+distributed_backend: deepspeed
+deepspeed_zero_stage: 2
+deepspeed_offload_optimizer_device: none
+deepspeed_offload_param_device: none
+deepspeed_zero3_init_flag: false
+deepspeed_gather_16bit_weights_on_model_save: false
+deepspeed_contiguous_gradients: false
+deepspeed_overlap_comm: false
+deepspeed_reduce_bucket_size: 2000000
+deepspeed_stage3_prefetch_bucket_size: 2000000
+deepspeed_stage3_param_persistence_threshold: 10000
+deepspeed_sub_group_size: 50000000
+deepspeed_stage3_max_live_parameters: 20000000
+deepspeed_stage3_max_reuse_distance: 20000000
+
+kl_temperature: 1.0
+kl_loss_weight: 0.25
+cot_ce_loss_weight: 1
+latent_start_ce_loss_weight: 1
+latent_end_ce_loss_weight: 1
+im_end_ce_loss_weight: 1
+halt_dense_loss_stage1_weight: 0.075
+halt_dense_loss_stage2_final_weight: 0.025
+halt_dense_loss_projection_mode: ce_quality_gate
+halt_dense_ce_gate_ema_beta: 0.98
+early_exit_front_fraction: 1.0
+early_exit_front_weight: 2.0
+early_exit_nonfront_weight: 1.0
+early_exit_rank_margin: 0.3
+latent_end_soft_target_curve: smoothstep
+latent_end_soft_target_temperature: 1
+latent_end_soft_target_power: 1.5
+latent_end_soft_loss_weight: 1.0
+other_end_hard_loss_weight: 0.25
+
+student_max_new_tokens: 4096
+val_max_new_tokens: 256
+val_max_new_tokens_warmup_steps: 6000
+val_max_new_tokens_warmup: 256
+eval_do_sample: true
+eval_temperature: 0.6
+eval_top_p: 0.95
+eval_top_k: 20
+latent_max_steps: 128
+cot_max_new_tokens: 4096
+supervised_logits_chunk_size: 64
+discrete_chunk_size: 128
+train_stage: 1
+# Keep stage 2 unreachable on one GPU; it would unfreeze all 4B parameters.
+stage2_start_fraction: 2.0
+stage2_easy_sample_prob: 0.2
+stage2_easy_cot_max_tokens: 16384
+use_custom_attention_bias: false
+lazy_dataset: true
+latent_bptt_window: 0
+enable_rank_pad_sync: true
+kl_topk_dim: 128
+curriculum_power: 0.8
+
+save_every_steps: 250
+save_latest_every_steps: 75
+latest_checkpoint_name: latest
+eval_every_steps: 250
+max_val_batches: 0
+eval_generation_mode: rank_sharded_lockstep
+eval_log_mode: main_aggregate_plus_rank_details
+save_training_state: false
+save_on_exception: false
+resume_training: false
+resume_from_checkpoint: latest
+resume_override_global_step: null
+max_auto_stage_restarts: 0
+
+enable_memory_profile: true
+enable_forward_memory_breakdown_log: false
+enable_tensorboard: true
+tensorboard_root: runs/tensorboard
+tensorboard_run_name: later-4b-stage1
+tensorboard_flush_secs: 1
+log_level: INFO
+log_dir: logs/later-4b-stage1
+train_log_file: train.log
